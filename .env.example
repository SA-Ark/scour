# Scour live demo — environment (all optional; the demo is self-contained)
#
# Bind address. SCOUR_ADDR wins if set (full host:port). Otherwise the server
# binds 0.0.0.0:$PORT. Defaults to 127.0.0.1:8087 for a bare `cargo run`.
SCOUR_ADDR=0.0.0.0:3942
PORT=3942

# Log filter (the binary only logs to stderr; no tracing dependency).
RUST_LOG=scour=info

# Observability service name (used by the deploy manifest; no runtime dep).
OTEL_SERVICE_NAME=scour
